rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public journal entries: anyone can read, but must be logged in (authenticated) to create, update, or delete
    match /entries/{entryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User-scoped entries and private collections: read is public or owner, write requires matching auth.uid
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Fallback document rule
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}


